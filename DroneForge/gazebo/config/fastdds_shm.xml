<?xml version="1.0" encoding="UTF-8" ?>
<!-- DroneForge sim: 640x480 camera frames are ~0.9 MB; FastDDS's default 0.5 MB shared-memory segment sent them over UDP loopback in fragments and lost ~1/4 at 30 fps.
     16 MB segments keep whole frames in shared memory. Used by every node run_house.sh starts (FASTRTPS_DEFAULT_PROFILES_FILE). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_local</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="droneforge_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp_local</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
