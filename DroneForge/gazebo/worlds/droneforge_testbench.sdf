<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="droneforge_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <direction>-0.5 0.2 -0.85</direction>
    </light>

    <!-- Arena Floor Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.52 1.0</ambient>
            <diffuse>0.6 0.6 0.62 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center Landing Pad (Target at 0, 0) -->
    <model name="landing_pad">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="pad_link">
        <visual name="pad_outer">
          <geometry><cylinder><radius>0.40</radius><length>0.002</length></cylinder></geometry>
          <material><diffuse>0.9 0.5 0.0 1.0</diffuse></material>
        </visual>
        <visual name="pad_inner">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.002</length></cylinder></geometry>
          <material><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
        </visual>
        <visual name="pad_center">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.002</length></cylinder></geometry>
          <material><diffuse>0.9 0.1 0.1 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Reference Visual Features / Obstacles for Camera & Flow -->
    <model name="feature_marker_1">
      <static>true</static>
      <pose>1.5 1.0 0.3 0 0 0.5</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.4 0.4 0.6</size></box></geometry><material><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
      </link>
    </model>

    <model name="feature_marker_2">
      <static>true</static>
      <pose>2.0 -1.2 0.4 0 0 -0.3</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry><material><diffuse>0.8 0.2 0.3 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="feature_marker_3">
      <static>true</static>
      <pose>-1.5 1.5 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><diffuse>0.2 0.7 0.3 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- High-Contrast Floor Target Grid for Visual Odometry & SuperPoint Tracking -->
    <model name="floor_grid_targets">
      <static>true</static>
      <pose>0 0 0.0005 0 0 0</pose>
      <link name="grid_link">
        <visual name="tile_fwd_1"><pose>0.6 0.0 0 0 0 0</pose><geometry><box><size>0.25 0.25 0.001</size></box></geometry><material><diffuse>0.1 0.7 0.8 1</diffuse></material></visual>
        <visual name="tile_fwd_2"><pose>1.2 0.0 0 0 0 0</pose><geometry><box><size>0.25 0.25 0.001</size></box></geometry><material><diffuse>0.8 0.6 0.1 1</diffuse></material></visual>
        <visual name="tile_fl"><pose>0.6 0.5 0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.001</length></cylinder></geometry><material><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
        <visual name="tile_fr"><pose>0.6 -0.5 0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.001</length></cylinder></geometry><material><diffuse>0.8 0.2 0.8 1</diffuse></material></visual>
        <visual name="tile_l"><pose>0.0 0.6 0 0 0 0</pose><geometry><box><size>0.2 0.2 0.001</size></box></geometry><material><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
        <visual name="tile_r"><pose>0.0 -0.6 0 0 0 0</pose><geometry><box><size>0.2 0.2 0.001</size></box></geometry><material><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
        <visual name="tile_bl"><pose>-0.6 0.5 0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.001</length></cylinder></geometry><material><diffuse>0.7 0.7 0.1 1</diffuse></material></visual>
        <visual name="tile_br"><pose>-0.6 -0.5 0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.001</length></cylinder></geometry><material><diffuse>0.1 0.8 0.7 1</diffuse></material></visual>
        <visual name="tile_bwd"><pose>-0.6 0.0 0 0 0 0</pose><geometry><box><size>0.25 0.25 0.001</size></box></geometry><material><diffuse>0.5 0.2 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Drone Model -->
    <include>
      <uri>model://droneforge_3in</uri>
      <name>droneforge_3in</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

  </world>
</sdf>
