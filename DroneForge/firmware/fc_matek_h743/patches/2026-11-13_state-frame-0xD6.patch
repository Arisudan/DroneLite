+/*
+0xD6 Compact state: range + optical flow + EKF velocity + attitude in one frame (replaces 0xD3 + 0xD4 + 0x1E on the air: 26 bytes instead of 50).
+Layout and units: telemetry/crsf_state_pack.h (same units as D3 and D4, position is NOT sent).
+*/
+static void crsfFrameState(sbuf_t *dst) {
+  const kinematicState_t *state = kinematicEstimatorGetState();
+  const int32_t distValueCm = rangefinderGetLatestAltitude();
+  const int32_t distValueMm = (distValueCm >= 0) ? (distValueCm * 10) : distValueCm;
+  const uint16_t distRaw = (distValueMm >= 0) ? (uint16_t)constrain(distValueMm, 0, 65535) : UINT16_MAX;
+  const bool ekfValid = isfinite(state->velX) && isfinite(state->velY) && isfinite(state->velZ);
+  uint8_t data[CRSF_STATE_PAYLOAD_BYTES];
+
+  const uint8_t n = crsfStatePack(data, distRaw, opticalflowGetLatestVelX(), opticalflowGetLatestVelY(), opticalflowGetLatestFlowQuality(), ekfValid,
+                                  opticalflowGetLatestFlowStatus(), crsfMetersPerSecondToMillimetersPerSecond(state->velX),
+                                  crsfMetersPerSecondToMillimetersPerSecond(state->velY), crsfMetersPerSecondToMillimetersPerSecond(state->velZ),
+                                  decidegrees2Radians10000(attitude.values.roll), decidegrees2Radians10000(attitude.values.pitch),
+                                  decidegrees2Radians10000(attitude.values.yaw));
+  sbufWriteU8(dst, CRSF_FRAME_STATE_PAYLOAD_SIZE + CRSF_FRAME_LENGTH_TYPE_CRC);
+  sbufWriteU8(dst, CRSF_FRAMETYPE_STATE);
+  for (uint8_t i = 0; i < n; i++) {
+    sbufWriteU8(dst, data[i]);
+  }
+}
+#endif
