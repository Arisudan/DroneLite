+int16_t rcCommandThrottleFromUs(float us)         // exactly the non-3D throttle path of updateRcCommands(), for a throttle given in channel microseconds (height hold)
+{
+    int32_t tmp = constrain((int32_t)us, rxConfig()->mincheck, PWM_RANGE_MAX);
+    tmp = (uint32_t)(tmp - rxConfig()->mincheck) * PWM_RANGE_MIN / (PWM_RANGE_MAX - rxConfig()->mincheck);
+    if (getLowVoltageCutoff()->enabled) {
+        tmp = tmp * getLowVoltageCutoff()->percentage / 100;
+    }
+    return rcLookupThrottle(tmp);
+}
