+// battery/attitude/etc., so a higher rate may starve the other frames. NimbusOS only needs a sample inside 0.5 s.
+#define CRSF_OPTRANGE_INTERVAL_US 50000
+
+// BEGIN NIMBUS-OPTRANGE
+// Custom frame 0xD3 as decoded by NimbusOS 2.9.0 (all multi-byte fields big-endian):
+//   [0..1] distance        int16   millimetres; 0 when invalid (the PC treats raw 1..5999 as valid)
+//   [2]    dist_strength   uint8   lidar quality byte from the sensor (0..255)
+//   [3]    dist_precision  uint8   not available in Betaflight: always 0
+//   [4..5] flow_x          int16   0.01 rad/s (PC: forward velocity = distance_m * flow_x / 100)
+//   [6..7] flow_y          int16   0.01 rad/s (PC: right velocity   = -distance_m * flow_y / 100)
+//   [8]    flow_quality    uint8
+//   [9]    flow_status     uint8   1 = valid
+// Sent on a timer even when the sensor has stalled on purpose: the PC's flat-line watchdog relies on seeing
+// byte-identical frames to detect a frozen sensor.
+static void crsfFrameOptrange(sbuf_t *dst)
+{
+    const int32_t mm = mtRangefinderGetLastDistanceMm();
+    const uint16_t distance = (mm >= 1 && mm <= 5999) ? (uint16_t)mm : 0;
+
+    const opticalflow_t *flow = getOpticalFlowData();
+    const bool flowOk = isOpticalflowHealthy() && flow->flowRateValid[0] && flow->flowRateValid[1];
+    // Which flow vector Nimbus sends (raw, or gyro-compensated like this one) is UNKNOWN; axis signs must be
+    // calibrated on the bench by moving the drone forward/right and checking the sign on the PC.
+    const int16_t flowX = flowOk ? (int16_t)constrainf(lrintf(flow->processedFlowRates.x * 100.0f), INT16_MIN, INT16_MAX) : 0;
+    const int16_t flowY = flowOk ? (int16_t)constrainf(lrintf(flow->processedFlowRates.y * 100.0f), INT16_MIN, INT16_MAX) : 0;
+    const uint8_t flowQuality = flowOk ? (uint8_t)constrain(flow->quality, 0, 255) : 0;
+
+    // use sbufWrite since CRC does not include frame length
+    sbufWriteU8(dst, CRSF_FRAME_OPTRANGE_PAYLOAD_SIZE + CRSF_FRAME_LENGTH_TYPE_CRC);
+    sbufWriteU8(dst, CRSF_FRAMETYPE_OPTRANGE);
+    sbufWriteU16BigEndian(dst, distance);
+    sbufWriteU8(dst, mtRangefinderGetLastQuality());
+    sbufWriteU8(dst, 0);
+    sbufWriteU16BigEndian(dst, (uint16_t)flowX);
+    sbufWriteU16BigEndian(dst, (uint16_t)flowY);
+    sbufWriteU8(dst, flowQuality);
+    sbufWriteU8(dst, flowOk ? 1 : 0);
+}
+// END NIMBUS-OPTRANGE
